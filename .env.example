# Copy to .env and adjust. Never commit the real .env.
NODE_ENV=production
PORT=8787
HOST=0.0.0.0
DB_PATH=./data/onecolor.db
# Public address of this server (used in e-mail links)
PUBLIC_URL=https://api.example.com
# Allowed web origins for the API (comma separated, * for any)
CORS_ORIGINS=https://onecolor.example.com
# Serve the exported web game from this folder (optional, same origin as the API)
WEB_DIR=
TOKEN_TTL_DAYS=30
REQUIRE_EMAIL_VERIFICATION=false
# SMTP: leave SMTP_HOST empty to disable e-mail (the app will say so)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ONE COLOR <no-reply@example.com>
SEASON_LENGTH_DAYS=56
DAILY_TZ_OFFSET_MIN=540
DEV_OUTBOX=false
